# Local Homebrew/Docker Postgres, or the Supabase URI.
# For Supabase append "?uselibpqcompat=true&sslmode=require" — without uselibpqcompat the pg driver
# verifies the certificate chain and fails with "self-signed certificate in certificate chain".
DATABASE_URL="postgresql://blog:blog@localhost:5432/study_editions"

ADMIN_PASSWORD="study-editions"
SESSION_SECRET="replace-with-a-long-random-string"

# From Vercel: Storage → blog-store → .env.local
# Leave empty locally to save plates under public/uploads
BLOB_READ_WRITE_TOKEN=""
