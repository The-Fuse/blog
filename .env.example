# Local Homebrew/Docker Postgres, or the Supabase URI (any sslmode works; TLS is handled in lib/db.ts).
# On Vercel, DATABASE_URL should be the Supabase transaction pooler (port 6543). The build prerenders
# the home page through it. Migrations are NOT run by the build: apply them with
# `npm run db:deploy:prod`, which uses SUPABASE_DATABASE_URL (the direct connection) below.
# SUPABASE_DATABASE_URL="postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://blog:blog@localhost:5432/study_editions"

ADMIN_PASSWORD="study-editions"
SESSION_SECRET="replace-with-a-long-random-string"

# From Vercel: Storage → blog-store → .env.local
# Leave empty locally to save plates under public/uploads
BLOB_READ_WRITE_TOKEN=""
