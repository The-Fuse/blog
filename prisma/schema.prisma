generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id               String   @id @default(cuid())
  slug             String   @unique
  kicker           String   @default("")
  title            String
  dek              String   @default("")
  topic            String
  status           String   @default("draft")
  featured         Boolean  @default(false)
  publishDate      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  author           String   @default("Rohit Yadav")
  leadPlateUrl     String?
  leadPlateCaption String   @default("")
  blocks           Json     @default("[]")
  /// Words in title, subtitle and body, kept up to date on save so lists never need the body.
  wordCount        Int      @default(0)

  @@index([status, publishDate])
  @@index([updatedAt])
}

/// Single-row site settings edited from the admin (About section, contact email).
model Site {
  id           Int      @id @default(1)
  aboutHeading String   @default("About")
  aboutText    String   @default("Long-form study editions of philosophers and of technical ideas — arguments set out as arguments, with every diagram drawn in one visual grammar.")
  aboutNote    String   @default("New edition roughly every month.")
  contactEmail String   @default("")
  updatedAt    DateTime @updatedAt
}
